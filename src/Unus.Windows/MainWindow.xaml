
<Window x:Class="Unus.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Unus"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        Foreground="#F1F5F9">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#141D30"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#26344B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#202D45"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334563"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#10192A"
                BorderBrush="#26344B"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="22">

                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,38">
                        <Border Width="36"
                                Height="36"
                                Background="#6366F1"
                                CornerRadius="10">
                            <TextBlock Text="U"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="UNUS"
                                       FontSize="19"
                                       FontWeight="Bold"/>
                            <TextBlock Text="SOFTWARE KVM"
                                       FontSize="9"
                                       Foreground="#94A3B8"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="WORKSPACE"
                               FontSize="10"
                               Foreground="#64748B"
                               FontWeight="Bold"
                               Margin="4,0,0,12"/>

                    <Border Background="#242B52"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈"
                                       Foreground="#A5B4FC"
                                       FontSize="17"
                                       Margin="0,0,12,0"/>
                            <TextBlock Text="Overview"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Margin="12,12,0,12"
                                Opacity="0.55">
                        <TextBlock Text="▣"
                                   FontSize="16"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="Devices"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="12,12,0,12"
                                Opacity="0.55">
                        <TextBlock Text="▤"
                                   FontSize="16"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="Display Layout"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1"
                            Background="#26344B"
                            Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="12,8">
                        <TextBlock Text="⚙"
                                   FontSize="16"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="Settings"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="PROJECT UNUS • EARLY ACCESS"
                               FontSize="9"
                               Foreground="#64748B"
                               Margin="4,24,0,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="38,30,38,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,32">
                <StackPanel>
                    <TextBlock Text="Overview"
                               FontSize="28"
                               FontWeight="Bold"/>
                    <TextBlock Text="Manage your connected workspace."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="13"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Welcome -->
            <Border Grid.Row="1"
                    Background="#192541"
                    BorderBrush="#34466A"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="24"
                    Margin="0,0,0,24">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="YOUR WORKSPACE"
                                   Foreground="#A5B4FC"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Welcome to Unus."
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Margin="0,8,0,6"/>
                        <TextBlock Text="One workspace. Multiple computers. Seamless control."
                                   Foreground="#B8C5D9"
                                   FontSize="13"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="72"
                            Height="72"
                            CornerRadius="18"
                            Background="#303C72"
                            VerticalAlignment="Center">
                        <TextBlock Text="◈"
                                   FontSize="42"
                                   Foreground="#C7D2FE"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Dashboard cards -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Workspace status"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- This device -->
                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="THIS DEVICE"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontWeight="Bold"/>

                            <TextBlock x:Name="LocalDeviceName"
                                       Text="Loading..."
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,8"
                                       TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#34D399"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Application running"
                                           Foreground="#34D399"
                                           FontSize="12"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Connection status -->
                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20">

                        <StackPanel>
                            <TextBlock Text="NETWORK STATUS"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Not connected"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,8"/>

                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="#FBBF24"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Waiting for another device"
                                           Foreground="#FBBF24"
                                           FontSize="12"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Device discovery area -->
                <Border Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22">

                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Your devices"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Computers available in your workspace."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <Button Content="Discovery coming soon"
                                    IsEnabled="False"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="#10192A"
                                BorderBrush="#26344B"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="20">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="0,15">

                                <TextBlock Text="⌁"
                                           FontSize="38"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="No devices connected"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,5"/>

                                <TextBlock Text="Device discovery will be available in our next milestone."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
