<Window x:Class="Unus.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNUS"
        Height="820"
        Width="1200"
        MinHeight="680"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Window.Resources>

        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D1117"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#111720"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#161E29"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#283444"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5B9BFF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8F9BAA"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AAB6C5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#C9D3DF"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">

            <DockPanel Margin="20">

                <StackPanel DockPanel.Dock="Top">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,38">

                        <Border Width="35"
                                Height="35"
                                CornerRadius="9"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Center">

                            <TextBlock Text="U"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="UNUS"
                                       FontSize="19"
                                       FontWeight="Bold"/>

                            <TextBlock Text="SOFTWARE KVM"
                                       FontSize="9"
                                       Foreground="{StaticResource MutedBrush}"/>

                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="WORKSPACE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="4,0,0,12"/>

                    <Button Style="{StaticResource NavigationButton}"
                            Content="◈   Overview"/>

                    <Button Style="{StaticResource NavigationButton}"
                            Content="▣   Devices"/>

                    <Button Style="{StaticResource NavigationButton}"
                            Content="▦   Display Layout"/>

                    <Button Style="{StaticResource NavigationButton}"
                            Content="⚙   Settings"/>

                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="0,0,0,8">

                    <Border Height="1"
                            Background="{StaticResource BorderBrush}"
                            Margin="0,0,0,18"/>

                    <TextBlock Text="PROJECT UNUS"
                               FontSize="10"
                               Foreground="#64748B"/>

                    <TextBlock Text="Development Build"
                               FontSize="12"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Wi-Fi Direct Discovery"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,3,0,0"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- MAIN CONTENT -->

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="34,28,34,34">

                <!-- HEADER -->

                <Grid Margin="0,0,0,26">
                    <StackPanel>
                        <TextBlock Text="Overview"
                                   FontSize="25"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Manage your connected workspace."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- WELCOME PANEL -->

                <Border Background="#192638"
                        BorderBrush="#304763"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Welcome to UNUS"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="One workspace. Multiple devices. Seamless control."
                                   FontSize="13"
                                   Foreground="#AABBD0"
                                   Margin="0,8,0,0"/>

                    </StackPanel>
                </Border>

                <!-- WORKSPACE STATUS -->

                <TextBlock Text="WORKSPACE STATUS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,24">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="THIS COMPUTER"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock x:Name="LocalDeviceName"
                                       Text="Detecting..."
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,9,0,0"/>

                            <TextBlock Text="Local device"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">

                        <StackPanel>
                            <TextBlock Text="NETWORK"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"/>

                            <TextBlock Text="Wi-Fi Direct"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,9,0,0"/>

                            <TextBlock Text="Peer-to-peer discovery"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                </Grid>

                <!-- DISCOVERED DEVICES -->

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22"
                        Margin="0,0,0,20">

                    <StackPanel>

                        <Grid Margin="0,0,0,18">

                            <StackPanel>
                                <TextBlock Text="Your devices"
                                           FontSize="17"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Computers available in your workspace."
                                           FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <Border Background="#20352B"
                                    CornerRadius="6"
                                    Padding="10,5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                                <TextBlock x:Name="DiscoveryStatusText"
                                           Text="Starting discovery..."
                                           FontSize="10"
                                           Foreground="#70D994"/>
                            </Border>

                        </Grid>

                        <Border x:Name="NoDevicesPanel"
                                Background="#111923"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="22">

                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="No devices discovered yet"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Waiting for nearby Wi-Fi Direct devices..."
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"/>

                            </StackPanel>

                        </Border>

                        <ItemsControl x:Name="DiscoveredDevicesList"
                                      Margin="0,10,0,0">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#111923"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="15"
                                            Margin="0,0,0,8">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Text="{Binding DeviceId}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,5,0,0"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="Discovered"
                                                       Foreground="#70D994"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

                <!-- DISCOVERY EVENT MONITOR -->

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22">

                    <StackPanel>

                        <TextBlock Text="Discovery event monitor"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Live diagnostic events reported by Windows Wi-Fi Direct."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,16"/>

                        <ListBox x:Name="DiscoveryLogList"
                                 Background="#10151D"
                                 BorderThickness="0"
                                 Foreground="#C9D3DF"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Padding="10"
                                 MaxHeight="280"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>

                        </ListBox>

                    </StackPanel>

                </Border>

                <!-- FOOTER -->

                <TextBlock Text="UNUS • Wi-Fi Direct Discovery Test"
                           FontSize="10"
                           Foreground="#64748B"
                           HorizontalAlignment="Right"
                           Margin="0,18,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>